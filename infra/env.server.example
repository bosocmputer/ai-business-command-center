# Copy to .env.server on the deployment server.
# Do not commit real credentials.

AI_BCC_WEB_PORT=3055
AI_BCC_API_PORT=4055
OWNER_AUTH_SECRET=replace-with-32-plus-random-characters

# Bootstrap only. Runtime config belongs in Owner UI and System DB.
AI_BCC_SYSTEM_DB_NAME=ai_business_command_center
AI_BCC_SYSTEM_DB_USER=ai_bcc
AI_BCC_SYSTEM_DB_PASSWORD=replace-with-strong-password
SYSTEM_DATABASE_URL=postgresql://ai_bcc:replace-with-strong-password@system-db:5432/ai_business_command_center
AI_BCC_SECRET_KEY=replace-with-32-plus-random-characters
AI_BCC_CONFIG_FILE=.data/ai-bcc.config.json

# Worker bootstrap. Store schedules are read from notification_rules in System DB.
AI_BCC_WORKER_API_BASE_URL=http://api:4000
WORKER_ID=worker_notification_rules_1
WORKER_NOTIFICATION_MODE=send
WORKER_HEARTBEAT_TOKEN=
