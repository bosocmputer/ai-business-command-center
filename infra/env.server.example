# Copy to .env.server on the deployment server.
# Do not commit real credentials.

AI_BCC_WEB_PORT=3055
AI_BCC_API_PORT=4055
APP_BASE_URL=http://192.168.2.109:3055
NEXT_PUBLIC_API_BASE_URL=http://192.168.2.109:4055
REPORT_VIEWER_SIGNING_SECRET=replace-with-32-plus-random-characters
REPORT_VIEWER_LINK_TTL_HOURS=72
AI_BCC_ADMIN_TOKEN=replace-with-admin-token-for-mutation-endpoints

# System PostgreSQL is separate from every customer SML database.
AI_BCC_SYSTEM_DB_NAME=ai_business_command_center
AI_BCC_SYSTEM_DB_USER=ai_bcc
AI_BCC_SYSTEM_DB_PASSWORD=replace-with-strong-password
SYSTEM_DATABASE_URL=postgresql://ai_bcc:replace-with-strong-password@system-db:5432/ai_business_command_center

SML_DEMO_DB_HOST=your-demo-db-host
SML_DEMO_DB_PORT=47309
SML_DEMO_DB_NAME=demo
SML_DEMO_DB_USER=readonly_user
SML_DEMO_DB_PASSWORD=replace-me

SML_OFFICE_DB_HOST=your-office-db-host
SML_OFFICE_DB_PORT=5432
SML_OFFICE_DB_NAME=sml1_2026
SML_OFFICE_DB_USER=readonly_user
SML_OFFICE_DB_PASSWORD=replace-me

LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_WEBHOOK_DEBUG_TOKEN=
LINE_TARGET_ID=
LINE_DEMO_CHANNEL_ACCESS_TOKEN=
LINE_DEMO_TARGET_ID=
LINE_OFFICE_CHANNEL_ACCESS_TOKEN=
