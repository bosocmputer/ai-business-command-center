# Copy to .env.local for development. Do not commit real credentials.

API_HOST=127.0.0.1
API_PORT=4000
APP_BASE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000

# System DB for report_runs/report_snapshots/audit_logs.
# Leave blank for local JSON persistence at .data/system-store.json.
SYSTEM_DATABASE_URL=postgresql://ai_bcc_user:replace-me@localhost:5432/ai_business_command_center

# tenant_demo_remote datasource
SML_DEMO_DB_HOST=your-demo-db-host
SML_DEMO_DB_PORT=5432
SML_DEMO_DB_NAME=demo
SML_DEMO_DB_USER=readonly_user
SML_DEMO_DB_PASSWORD=replace-me

# tenant_office_sml1_2026 datasource
SML_OFFICE_DB_HOST=your-office-db-host
SML_OFFICE_DB_PORT=5432
SML_OFFICE_DB_NAME=sml1_2026
SML_OFFICE_DB_USER=readonly_user
SML_OFFICE_DB_PASSWORD=replace-me

# LINE OA sender.
# Prefer tenant-specific values in production so each tenant/channel is isolated.
# If tenant-specific values are blank, API can fall back to LINE_CHANNEL_ACCESS_TOKEN/LINE_TARGET_ID.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_ID=

LINE_DEMO_CHANNEL_ACCESS_TOKEN=
LINE_DEMO_TARGET_ID=

LINE_OFFICE_CHANNEL_ACCESS_TOKEN=
LINE_OFFICE_TARGET_ID=
